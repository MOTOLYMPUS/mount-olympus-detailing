# ─────────────────────────────────────────────────────────────────────────────
# Per-app runtime secrets for the "manual" docker-compose path.
#
# Copy to `app-mountolympus.env` (no .example) and fill in. That real file is
# gitignored — it holds live keys and must never be committed.
#
# One file PER APP: app-mountolympus.env, app-client-two.env, … Each app reads
# only its own, so ten apps keep ten separate sets of secrets and databases.
#
# NOTE: NEXT_PUBLIC_SITE_URL is a BUILD arg (set in docker-compose.multi.yml),
# not here — it is compiled into the browser bundle, so it must be present at
# build time, not only at run time. Everything below is read at run time.
# ─────────────────────────────────────────────────────────────────────────────

# Persistence — these MUST point at the mounted /data volume or data is lost.
DATABASE_PATH=/data/data.sqlite
UPLOAD_DIR=/data/uploads

# Rate-limiting salt — generate once per app:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Email (Resend) — optional; without it the app runs and records the skip.
RESEND_API_KEY=
MAIL_FROM=Mount Olympus Detailing <onboarding@resend.dev>
BUSINESS_EMAIL=luis.rodriguez621@outlook.com

# Booking link (optional) — Calendly / Google / Square URL.
NEXT_PUBLIC_BOOKING_URL=

# Payments (optional) — Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Scheduled reminders (optional).
CRON_SECRET=
