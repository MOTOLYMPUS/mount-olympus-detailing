# Never ship these into the image.
node_modules
.next
.next-*
.verify-build
out

# Local data + secrets — must come from the host's volume and env, never baked in.
data.sqlite
data.sqlite-shm
data.sqlite-wal
*.sqlite
# Anchored: a bare `uploads` also excluded app/api/uploads (the upload route)
# from the image. See the matching note in .gitignore.
/uploads
.env.local
.env*.local

# Dev noise
.git
.gitignore
*.log
build-verify.log
.DS_Store
npm-debug.log*
content/drafts
