node_modules
.next
out
.env.local
.env*.local
.DS_Store
*.log

# SQLite database — contains real customer contact details. Never commit.
data.sqlite
data.sqlite-shm
data.sqlite-wal
*.sqlite

# Uploaded files — customer vehicle photos and handwritten signatures.
# Personal data; never commit, and back it up alongside the database rather
# than relying on version control.
#
# ANCHORED to the repo root on purpose. An unanchored `uploads/` matches a
# directory named "uploads" at ANY depth — including app/api/uploads/, the
# upload ROUTE — which is how that route went uncommitted and the live site
# shipped without it. Same fix in .dockerignore.
/uploads/

# Alternate build dirs used when two Next instances run in parallel
.next-*

# TypeScript incremental build cache
*.tsbuildinfo

# Per-app server secrets for the self-hosted multi-app setup (deploy/). The
# .example templates ARE committed; the real filled-in files must never be.
deploy/*.env
deploy/litestream.yml
deploy/Caddyfile.local

